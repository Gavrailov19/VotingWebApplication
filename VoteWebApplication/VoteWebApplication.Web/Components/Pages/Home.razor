@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.WebUtilities
@using VoteWebApplication.ServiceDefaults.Shared.Models
@inject NavigationManager Nav
@inject IHttpClientFactory Clients

<h1 class="mb-4">Todays Votings</h1>

<h2 class="mb-4">Time: @_timeRightNow</h2>

@if (string.IsNullOrEmpty(_userName) || _userName.ToLower() == "clock" || _userName.ToLower() == "system")
{
    <p class="text-danger">To vote please add to the url your username in this way <code>?user=YourName</code> 
        <br />Don't use usernames clock and system, they are special
    </p>
}
else
{
    @foreach (var poll in _allPolls)
    {        
        int total = poll.Options.Sum(o => o.Votes);
        <div class="@($"poll-stack mb-4 {(poll.isVoteActive ? "" : "poll-closed")}")">
            <div class="poll">
                <div class="poll-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">@poll.Question</span>
                    <span class="badge @(poll.isVoteActive ? "live-badge" : "bg-secondary")">
                        @(poll.isVoteActive ? "LIVE" : "CLOSED")
                    </span>
                </div>

                @foreach (var option in poll.Options)
                {
                    var votesForOptionInPercent = total > 0 ? option.Votes * 100 / total : 0;
                    var isDominant = poll.Options.Any(x => x.Votes > option.Votes);
                    var isSelected = _selectedOptions.TryGetValue(poll.Id, out var sel)
                    && sel == option.Text;

                    <div class="poll-option
                            @(isDominant ? " dominant" : "")
                            @(isSelected ? " selected" : "")
                            @(poll.isVoteActive ? "" : " disabled")"
                         style="--w:@votesForOptionInPercent;@(poll.isVoteActive ? " cursor: pointer;" : "")"
                         @onclick="async () => {
                         if (poll.isVoteActive)
                         {
                             await OnVote(poll.Id, option.Text);
                         }
                     }">
                      <span class="label">@option.Text</span>
                      <div class="bar"></div>
                      <span class="pct">@votesForOptionInPercent&nbsp;%</span>
                  </div>
            }

                <div class="poll-footer text-end small">
                    @if (_selectedOptions.TryGetValue(poll.Id.ToString(), out var votedText))
                    {
                        <div class="mb-1"><em>You voted for <strong>@votedText</strong>.</em></div>
                    }
                    <div>Created by @poll.CreatedByUser • Total votes: @total</div>
                </div>
                @if (poll.isVoteActive && poll.CreatedByUser == _userName)
                {
                    <button class="btn btn-sm btn-outline-danger mt-2"
                            @onclick="() => CloseVotingsForPoll(poll.Id)">
                        <i class="bi bi-x-lg me-1"></i> Close Voting
                    </button>
                }
            </div>
        </div>
    }
}

@code {
    private HubConnection? _hub;
    private string _userName = "";
    private Dictionary<string, string> _selectedOptions = new();
    private List<PollResultModel> _allPolls = new();
    private DateTime _timeRightNow = DateTime.Now;
    private System.Timers.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        _userName = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query).GetValueOrDefault("user", "")!;

        StartClock();

        await InitialisingConnectionHub();

        HttpClient api = Clients.CreateClient("PollApi");
        HttpResponseMessage resp = await api.GetAsync($"api/poll/getall?user={_userName}");

        if (resp.IsSuccessStatusCode)
        {
            _allPolls = await resp.Content.ReadFromJsonAsync<List<PollResultModel>>() ?? new List<PollResultModel>();

            if (_allPolls.Count == 0)
            {
                await CreateSystemVoting();
                return;
            }

            foreach (var poll in _allPolls)
            {
                foreach (var opt in poll.Options)
                {
                    opt.Votes = poll.VotingResults.TryGetValue(opt.Text, out int numberOfVotes) ? numberOfVotes : 0;
                }

                if (poll.LoggedUserChoice != null)
                {
                    _selectedOptions[poll.Id] = poll.LoggedUserChoice;
                }
                await _hub!.SendAsync("RegisterPoll", poll.Id.ToString());
            }
            StateHasChanged();
        }
    }

    private void StartClock()
    {
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (_, __) =>
        {
            InvokeAsync(() =>
            {
                _timeRightNow = DateTime.Now;
                StateHasChanged();
            });
        };
        _timer.Start();
    }


    private async Task InitialisingConnectionHub()
    {
        var apiBase = Clients.CreateClient("PollApi").BaseAddress!.ToString().TrimEnd('/');
        _hub = new HubConnectionBuilder().WithUrl($"{apiBase}/votingHub").Build();

        // Receiving Real Time Votes!!!
        _hub.On<Dictionary<string, int>, string>("ReceiveVotes", async (voteCountForOption, pollId) =>
        {
            // Preventing UI Thread Exception
            await InvokeAsync(() =>
            {
                if (_allPolls.FirstOrDefault(p => p.Id == pollId) is PollResultModel poll)
                {
                    foreach (var opt in poll.Options)
                    {
                        opt.Votes = voteCountForOption.GetValueOrDefault(opt.Text);
                    }
                    StateHasChanged();
                }
            });
        });

        await _hub!.StartAsync();
    }

    private Task CloseVotingsForPoll(string pollId)
    {
        PollResultModel votingPollForDeleting = _allPolls.FirstOrDefault(p => p.Id == pollId)!;
        if (votingPollForDeleting is PollResultModel poll)
        {
            poll.isVoteActive = false;
        }

        _ = Task.Run(async () =>
        {
            await Task.Delay(TimeSpan.FromMinutes(15));

            await _hub!.SendAsync("DeregisterPoll", pollId);

            var api = Clients.CreateClient("PollApi");

            var resp = await api.DeleteAsync($"api/poll/delete?pollId={pollId}");

            if (resp.IsSuccessStatusCode)
            {
                _allPolls.Remove(votingPollForDeleting);
            }

            StateHasChanged();
        });
        return Task.CompletedTask;
    }

    private async Task OnVote(string pollId, string selectedOption)
    {
        // The votes can be made for every five minute interval
        if (_timeRightNow.Minute % 5 != 0)
        {
            return;
        }

        if (_selectedOptions.TryGetValue(pollId, out var previousOption) && previousOption == selectedOption)
        {
            return;
        }

        VotingModel voting = new()
        {
            Id = pollId,
            UsernameOfTheVoter = _userName,
            SelectedOption = selectedOption
        };

        await _hub!.SendAsync("RegisterVote", pollId, _userName, selectedOption);
        _selectedOptions[pollId] = selectedOption;
        StateHasChanged();
    }

    private async Task CreateSystemVoting()
    {
        string pollId = Guid.NewGuid().ToString();

        PollResultModel systemPoll = new();

        systemPoll.Question = "Lunch time! Where are we going team?";

        systemPoll.Options.AddRange(new[]
        {
            new PollOptionModel { Id = Guid.NewGuid(), Text = "The Kitchen" },
            new PollOptionModel { Id = Guid.NewGuid(), Text = "For Sushi" },
            new PollOptionModel { Id = Guid.NewGuid(), Text = "For Pizza" },
            new PollOptionModel { Id = Guid.NewGuid(), Text = "To the bar" },
            new PollOptionModel { Id = Guid.NewGuid(), Text = "I want to stay" }
        });

        CreateRequestPollModel request = new()
        {
            Question = systemPoll.Question,
            Options = systemPoll.Options.Select(o => o.Text).ToList(),
            CreatedByUser = "system",
        };
        HttpClient api = Clients.CreateClient("PollApi");
        HttpResponseMessage resp = await api.PostAsJsonAsync($"api/poll/create?id={pollId}", request);
        if (resp.IsSuccessStatusCode)
        {
            PollResultModel? resultModel = await resp.Content.ReadFromJsonAsync<PollResultModel>();
            _allPolls.Add(resultModel!);
            await _hub!.SendAsync("RegisterPoll", pollId);
        }
    }
}